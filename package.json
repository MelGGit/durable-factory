{
  "name": "durable-factory",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:server": "node --import tsx --watch apps/server/src/main.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "build:shared": "bun run --cwd packages/shared build",
    "build": "bun run check && bun run build:shared && bun run --cwd apps/web build && bun build apps/server/src/main.ts --target=node --packages=external --outfile=apps/server/dist/main.js",
    "start": "NODE_ENV=production node apps/server/dist/main.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-force-exit --test-concurrency=1 tests/*.test.ts",
    "diagnose": "node --import tsx scripts/diagnose.ts",
    "test:browser": "node --import tsx --test --test-force-exit tests/browser/*.test.ts",
    "format:check": "prettier --check apps packages scripts tests package.json tsconfig.json .prettierrc.json",
    "format": "prettier --write apps packages scripts tests package.json tsconfig.json .prettierrc.json"
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.3",
    "@ag-ui/core": "1.0.3",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.6.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  }
}
